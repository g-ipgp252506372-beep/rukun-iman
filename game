                if (element) element.classList.add('wrong');
            }
        }

        function nextScreen() { if (currentScreen < TOTAL_SCREENS) renderScreen(currentScreen + 1); }
        function prevScreen() { if (currentScreen > 1) renderScreen(currentScreen - 1); }

        /* ==========================================================================
           3. MEDIAPIPE HAND TRACKING & HOVER DWELL AR LOGIC
           ========================================================================== */
        function startARGame(mode) {
            document.getElementById('modal-start').classList.add('hidden');
            sounds.init();
            renderScreen(1);

            if (mode === 'camera') {
                document.getElementById('webcam').classList.remove('hidden');
                initMediaPipeHands();
            } else {
                document.getElementById('tracking-status-text').innerText = "Mod Tetikus / Sentuhan Skrin Aktif";
            }
        }

        function initMediaPipeHands() {
            const videoElement = document.getElementById('webcam');
            const reticle = document.getElementById('reticle');

            const hands = new Hands({
                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
            });

            hands.setOptions({
                maxNumHands: 1,
                modelComplexity: 1,
                minDetectionConfidence: 0.55,
                minTrackingConfidence: 0.55
            });

            hands.onResults((results) => {
                if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                    document.getElementById('tracking-status-dot').className = "w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping";
                    document.getElementById('tracking-status-text').innerText = "🎯 Tangan Dikesan — Kawal Kursor AR";

                    const landmarks = results.multiHandLandmarks[0];
                    // Index fingertip (Landmark 8) with mirrored x coordinate
                    const indexX = (1 - landmarks[8].x) * window.innerWidth;
                    const indexY = landmarks[8].y * window.innerHeight;

                    // Thumbtip (Landmark 4) for pinch gesture detection
                    const thumbX = (1 - landmarks[4].x) * window.innerWidth;
                    const thumbY = landmarks[4].y * window.innerHeight;

                    // Update reticle position
                    reticle.style.left = `${indexX}px`;
                    reticle.style.top = `${indexY}px`;

                    // Collision check
                    checkLockOnTarget(indexX, indexY);

                    // Pinch gesture trigger (Distance threshold)
                    const pinchDist = Math.hypot(indexX - thumbX, indexY - thumbY);
                    if (pinchDist < 45) {
                        const now = Date.now();
                        if (now - lastShootTime > 800) {
                            lastShootTime = now;
                            triggerARShoot();
                        }
                    }
                } else {
                    document.getElementById('tracking-status-dot').className = "w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse";
                    document.getElementById('tracking-status-text').innerText = "Arahkan tangan anda di hadapan kamera";
                    resetDwellProgress();
                }
            });

            // Akses kamera secara terus melalui getUserMedia
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                document.getElementById('tracking-status-text').innerText =
                    "Pelayar tidak menyokong kamera. Buka laman melalui HTTPS atau localhost.";
                return;
            }

            navigator.mediaDevices.getUserMedia({
                video: {
                    facingMode: "user",
                    width: { ideal: 1280 },
                    height: { ideal: 720 }
                },
                audio: false
            }).then((stream) => {
                videoElement.srcObject = stream;
                videoElement.onloadedmetadata = async () => {
                    try {
                        await videoElement.play();
                        document.getElementById('tracking-status-text').innerText =
                            "Kamera aktif — Arahkan tangan anda di hadapan kamera";

                        const processFrame = async () => {
                            if (videoElement.srcObject && videoElement.readyState >= 2) {
                                await hands.send({ image: videoElement });
                            }
                            if (videoElement.srcObject) {
                                requestAnimationFrame(processFrame);
                            }
                        };
                        processFrame();
                    } catch (err) {
                        console.warn("Video playback failed", err);
                        document.getElementById('tracking-status-text').innerText =
                            "Tidak dapat memulakan paparan kamera.";
                    }
                };
            }).catch((err) => {
                console.warn("Camera access failed", err);
                document.getElementById('tracking-status-text').innerText =
                    "Kamera tidak dapat diakses. Sila benarkan akses kamera pada pelayar.";
            });
        }

        function checkLockOnTarget(x, y) {
            const reticle = document.getElementById('reticle');
            const targetCards = document.querySelectorAll('.target-card');
            let foundCard = null;

            targetCards.forEach((card) => {
                const rect = card.getBoundingClientRect();
                if (x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom) {
                    foundCard = card;
                }
            });

            if (foundCard) {
                if (lockedTargetElement !== foundCard) {
                    sounds.playAimDing();
                    resetDwellProgress();
                    lockedTargetElement = foundCard;
                    
                    targetCards.forEach(c => c.classList.remove('locked'));
                    foundCard.classList.add('locked');
                    reticle.classList.add('locked');

                    // Start hover-dwell timer (Auto-click after 1.2s hover)
                    startDwellLock();
                }
            } else {
                if (lockedTargetElement) {
                    lockedTargetElement.classList.remove('locked');
                    lockedTargetElement = null;
                    reticle.classList.remove('locked');
                    resetDwellProgress();
                }
            }
        }

        function startDwellLock() {
            resetDwellProgress();
            const duration = 1200; // 1.2 seconds hover lock
            const startTime = Date.now();
            const progressCircle = document.getElementById('reticle-progress');

            lockTimer = setInterval(() => {
                const elapsed = Date.now() - startTime;
                lockProgress = Math.min(1, elapsed / duration);
                // Dasharray circumference is ~201 (2 * PI * 32)
                const offset = 201 * (1 - lockProgress);
                if (progressCircle) progressCircle.style.strokeDashoffset = offset;

                if (lockProgress >= 1) {
                    resetDwellProgress();
                    triggerARShoot();
                }
            }, 30);
        }

        function resetDwellProgress() {
            if (lockTimer) clearInterval(lockTimer);
            lockTimer = null;
            lockProgress = 0;
            const progressCircle = document.getElementById('reticle-progress');
            if (progressCircle) progressCircle.style.strokeDashoffset = 201;
        }

        function triggerARShoot() {
            if (lockedTargetElement) {
                const card = lockedTargetElement;
                resetDwellProgress();
                card.click();
            }
        }

        // Initialize on DOM Ready
        window.addEventListener('DOMContentLoaded', () => {
            renderScreen(1);
        });
